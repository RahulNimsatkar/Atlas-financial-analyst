# ==== REQUIRED ====
TELEGRAM_BOT_TOKEN=paste_token_from_botfather_here
GROQ_API_KEY=paste_groq_key_here

# ==== RECOMMENDED (free) ====
GEMINI_API_KEY=
FINNHUB_API_KEY=

# ==== OPTIONAL ====
DEFAULT_TIMEZONE=Asia/Kolkata
CHAT_MODEL=llama-3.1-8b-instant          # fast primary (8B)
RESEARCH_MODEL=llama-3.3-70b-versatile   # deep analysis (70B, auto-selected for research queries)
GEMINI_MODEL=gemini-2.0-flash
DATABASE_URL=sqlite:///atlas.db          # local dev; use PostgreSQL URL for deployment

# ==== NVIDIA FALLBACK ====
# When Groq hits its daily token limit, Atlas automatically switches to NVIDIA.
# Get a free key at build.nvidia.com → API Keys
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# ==== RENDER KEEP-ALIVE ====
# Set this to your deployed Render URL to prevent the free tier from sleeping.
# Example: https://atlas-bot.onrender.com
RENDER_URL=
